import silberschatz
import oreilly
diagram silberschatz style=silberschatz caption="style=silberschatz"
  row gap=44
    box a "Client" light
    box b "API" green
    box c "Store" yellow
  a -> b -> c
diagram oreilly style=oreilly caption="style=oreilly"
  row gap=44
    box a "Client" light
    box b "API" green
    box c "Store" yellow
  a -> b -> c
diagram balsamiq style=oreilly theme=balsamiq caption="theme=balsamiq"
  row gap=44
    box a "Client" light
    box b "API" green
    box c "Store" yellow
  a -> b -> c
diagram print style=oreilly theme=print caption="theme=print"
  row gap=44
    box a "Client" light
    box b "API" green
    box c "Store" yellow
  a -> b -> c
