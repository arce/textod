import styles
diagram fig2-9 (
    style=silberschatz size=17
    caption="Figure 2.9  Arduino execution. (a) At system startup. (b) " &
        "Running a sketch."
)
  row gap=40 align=start
    col gap=8 align=center
      col gap=0 w=140
        box fa "free memory" light h=150
        box "boot loader" white h=28
      text "(a)"
    col gap=8 align=center
      col gap=0 w=140
        box "free memory" light h=50
        box "user\nprogram\n(sketch)" silver h=100
        box "boot loader" white h=28
      text "(b)"
