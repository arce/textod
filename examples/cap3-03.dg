import boxed
diagram cap3-03 (
    style=boxed size=12 caption="Process control block (PCB)."
)
  col gap=6 align=center
    text "process control block (PCB)" bold
    col gap=0 w=230
      box "process state" light h=34
      box "process number" light h=34
      box "program counter" light h=34
      box "registers" light h=64
      box "memory limits" light h=34
      box "list of open files" light h=34
      box "..." light h=34
